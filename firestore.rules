rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { 
      allow read, write: if false; 
    }

    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn(); 
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'icon', 'createdAt', 'updatedAt']) && data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.icon is string && data.icon.size() > 0 && data.icon.size() <= 100 &&
             data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidCategoryUpdate(data) {
       return data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.icon is string && data.icon.size() > 0 && data.icon.size() <= 100 &&
             data.updatedAt == request.time;
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['title', 'description', 'drive_id', 'category_id', 'createdAt', 'updatedAt']) && data.keys().size() == 6 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.drive_id is string && data.drive_id.size() > 0 && data.drive_id.size() <= 100 &&
             data.category_id is string && data.category_id.size() > 0 && data.category_id.size() <= 128 &&
             data.createdAt == request.time && data.updatedAt == request.time;
    }

    function isValidPhotoUpdate(data) {
       return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.drive_id is string && data.drive_id.size() > 0 && data.drive_id.size() <= 100 &&
             data.category_id is string && data.category_id.size() > 0 && data.category_id.size() <= 128 &&
             data.updatedAt == request.time;
    }

    match /admins/{userId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /categories/{categoryId} {
      allow list: if true;
      allow get: if isValidId(categoryId);
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming());
      allow update: if isAdmin() && isValidId(categoryId) && isValidCategoryUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'updatedAt']) && incoming().createdAt == existing().createdAt;
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /photos/{photoId} {
      allow list: if true;
      allow get: if isValidId(photoId);
      allow create: if isAdmin() && isValidId(photoId) && isValidPhoto(incoming()) && exists(/databases/$(database)/documents/categories/$(incoming().category_id));
      allow update: if isAdmin() && isValidId(photoId) && isValidPhotoUpdate(incoming()) && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'drive_id', 'category_id', 'updatedAt']) && incoming().createdAt == existing().createdAt && exists(/databases/$(database)/documents/categories/$(incoming().category_id));
      allow delete: if isAdmin() && isValidId(photoId);
    }
  }
}
