rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn(); // Allow any signed-in user for now, as no role collection exists
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Entity Validations ---
    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'icon', 'createdAt', 'updatedAt']) && data.keys().size() == 4 &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.icon is string && data.icon.size() > 0 && data.icon.size() <= 100 &&
             data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    function isValidPhoto(data) {
      return data.keys().hasAll(['title', 'description', 'drive_id', 'category_id', 'createdAt', 'updatedAt']) && data.keys().size() == 6 &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 1000 &&
             data.drive_id is string && data.drive_id.size() > 0 && data.drive_id.size() <= 100 &&
             data.category_id is string && data.category_id.size() > 0 && data.category_id.size() <= 128 &&
             data.createdAt is timestamp && data.updatedAt is timestamp;
    }

    // --- Collections ---

    match /categories/{categoryId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(categoryId) && isValidCategory(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(categoryId) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'icon', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(categoryId);
    }

    match /photos/{photoId} {
      allow read: if true;
      allow create: if isAdmin() && isValidId(photoId) && isValidPhoto(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isAdmin() && isValidId(photoId) && incoming().updatedAt == request.time && incoming().createdAt == existing().createdAt && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'drive_id', 'category_id', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(photoId);
    }
  }
}
